NODE_ENV=development
PORT=5000
APP_BASE_URL=http://localhost:5000
DATABASE_URL=
# Required only by DB-backed integration tests. It must identify an explicit,
# isolated non-production database and never falls back to DATABASE_URL.
TEST_DATABASE_URL=
SESSION_SECRET=
RESEND_API_KEY=
EMAIL_FROM=
# Default is email_verification. Set to temporary_direct only for the
# documented, temporary registration fallback.
TUTELA_REGISTRATION_ACTIVATION=email_verification
SESSION_DB_POOL_MAX=5
DEMO_AUTH_BYPASS=false
DEMO_MODE=false
DEMO_TENANT_ID=
DEFAULT_TENANT_ID=
OPENAI_API_KEY=
STRIPE_SECRET_KEY=
VITE_STRIPE_PUBLIC_KEY=
PRICE_MA_ANNUAL=
PRICE_MA_MONTHLY=
PRICE_TD_ANNUAL=
PRICE_TD_MONTHLY=
PRICE_CS_ANNUAL=
PRICE_CS_MONTHLY=
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_BUCKET_NAME=
PRIVATE_OBJECT_DIR=
PUBLIC_OBJECT_SEARCH_PATHS=
SENTRY_DSN=
SENTRY_BACKEND_DSN=
VITE_SENTRY_DSN=
